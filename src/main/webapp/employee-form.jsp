<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><title>Employee Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><div class="container form"><h1><c:choose><c:when test="${employee != null}">Edit Employee</c:when><c:otherwise>Add Employee</c:otherwise></c:choose></h1><form method="post" action="${pageContext.request.contextPath}/employees"><input type="hidden" name="id" value="${employee.id != null ? employee.id : 0}"><label>Name</label><input name="name" value="${employee.name}" required><label>Email</label><input type="email" name="email" value="${employee.email}" required><label>Department</label><input name="department" value="${employee.department}" required><label>Salary</label><input type="number" step="0.01" min="0" name="salary" value="${employee.salary}" required><button class="btn" type="submit">Save</button> <a href="${pageContext.request.contextPath}/employees">Cancel</a></form></div></body></html>
