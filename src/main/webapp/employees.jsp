<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><title>Employees</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><div class="container"><div class="top"><h1>Employees</h1><a class="btn" href="${pageContext.request.contextPath}/employees/new">+ Add Employee</a></div><table><tr><th>ID</th><th>Name</th><th>Email</th><th>Department</th><th>Salary</th><th>Actions</th></tr><c:forEach var="e" items="${employees}"><tr><td>${e.id}</td><td>${e.name}</td><td>${e.email}</td><td>${e.department}</td><td>₹ ${e.salary}</td><td><a href="${pageContext.request.contextPath}/employees/edit?id=${e.id}">Edit</a> | <a onclick="return confirm('Delete this employee?')" href="${pageContext.request.contextPath}/employees/delete?id=${e.id}">Delete</a></td></tr></c:forEach></table><c:if test="${empty employees}"><p>No employees found.</p></c:if></div></body></html>
